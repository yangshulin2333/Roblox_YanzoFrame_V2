{
  "version": 1,
  "layout": {
    "descriptionRow": 1,
    "keyRow": 2,
    "typeRow": 3,
    "dataStartRow": 4
  },
  "sheets": [
    {
      "name": "ExampleGroups",
      "workbook": "GameConfig.xlsx",
      "descriptionZh": "Shared 示例分组，用于验证 ID 引用",
      "scope": "Shared",
      "primaryKey": "Id",
      "columns": [
        {
          "key": "Id",
          "descriptionZh": "唯一 ID（程序引用，不可重复，必填）",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "key": "DisplayName",
          "descriptionZh": "界面显示名称（文本，必填）",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "ExampleItems",
      "workbook": "GameConfig.xlsx",
      "descriptionZh": "Shared 示例数据，用于验证常用字段类型",
      "scope": "Shared",
      "primaryKey": "Id",
      "columns": [
        {
          "key": "Id",
          "descriptionZh": "唯一 ID（程序引用，不可重复，必填）",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "key": "DisplayName",
          "descriptionZh": "界面显示名称（文本，必填）",
          "type": "string",
          "required": true
        },
        {
          "key": "GroupId",
          "descriptionZh": "所属分组 ID（必须存在于 ExampleGroups 表，必填）",
          "type": "string",
          "required": true,
          "ref": "ExampleGroups.Id"
        },
        {
          "key": "Tier",
          "descriptionZh": "级别（只能填写 Common 或 Rare，必填）",
          "type": "string",
          "required": true,
          "enum": [
            "Common",
            "Rare"
          ]
        },
        {
          "key": "Price",
          "descriptionZh": "价格（数字，必须大于等于 0，必填）",
          "type": "number",
          "required": true,
          "min": 0
        },
        {
          "key": "Enabled",
          "descriptionZh": "是否启用（TRUE 或 FALSE，必填）",
          "type": "boolean",
          "required": true
        },
        {
          "key": "Note",
          "descriptionZh": "策划备注（可留空，不影响程序逻辑）",
          "type": "string",
          "required": false
        },
        {
          "key": "Tags",
          "descriptionZh": "标签列表（英文逗号分隔，可留空）",
          "type": "string[]",
          "required": false
        }
      ]
    },
    {
      "name": "ServerSettings",
      "workbook": "GameConfig.xlsx",
      "descriptionZh": "仅服务器可读的示例参数",
      "scope": "Server",
      "primaryKey": "Id",
      "columns": [
        {
          "key": "Id",
          "descriptionZh": "唯一 ID（程序引用，不可重复，必填）",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "key": "NumberValue",
          "descriptionZh": "服务器数值（数字，必须大于等于 0，必填）",
          "type": "number",
          "required": true,
          "min": 0
        },
        {
          "key": "Enabled",
          "descriptionZh": "是否启用（TRUE 或 FALSE，必填）",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ]
}
